.vercel
.env*
!.env.example

node_modules
.next/
dist/
coverage/
.turbo/
*.tsbuildinfo
.DS_Store

# Generated by docs/scripts/build-generated.sh — do not commit
# (docs/openspec/index.md is hand-authored and stays tracked; only the
# per-change subdirectories under it are generated)
/docs/roadmap.md
/docs/prd.md
/docs/openspec/*/

# Generated by docs/scripts/build-reports.sh — do not commit
# (docs/coverage/ is also covered by the bare coverage/ pattern above)
/docs/reports/

# Vendored reveal.js build for the pitch deck — intentionally checked in so
# the deck presents offline, not caught by the bare dist/ pattern above.
!/docs/assets/pitch/vendor/reveal/dist/
